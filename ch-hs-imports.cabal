cabal-version:       2.4

name:                ch-hs-imports
version:             0.1.0.0
license:             MIT
license-file:        LICENSE
author:              Handré Stolp
maintainer:          HanStolpo@gmail.com
extra-source-files:
  CHANGELOG.md
  test/golden/**/*.cabal
  test/golden/**/*.golden
  test/golden/**/*.hs
  test/golden/**/cabal.project
  test/golden/**/ghc-pkg-dump

executable ch-hs-imports
  main-is:             Main.hs
  build-depends :
   abstract-par,
   base,
   bytestring,
   Cabal-syntax,
   containers,
   deepseq,
   directory,
   dlist,
   filepath,
   megaparsec,
   monad-par,
   monad-par-extras,
   monoidal-containers,
   mtl,
   nonempty-containers,
   optparse-applicative,
   process,
   text,
   transformers

  hs-source-dirs:      src
  default-language:    Haskell2010
  ghc-options:
      -O2
      -threaded
      -rtsopts
      -with-rtsopts=-N
      -Werror
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wpartial-fields
      -Wredundant-constraints

test-suite golden
  type:                exitcode-stdio-1.0
  main-is:             Golden.hs
  hs-source-dirs:      test
  build-tool-depends:  ch-hs-imports:ch-hs-imports
  build-depends:
   base,
   bytestring,
   directory,
   filepath,
   process,
   tasty,
   tasty-golden,
   temporary,
   text
  default-language:    Haskell2010
  ghc-options:
      -threaded
      -Werror
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wpartial-fields
      -Wredundant-constraints
